BOT_TOKEN=1234567890:PASTE_YOUR_TOKEN_HERE

# Необязательно: Telegram ID владельцев через запятую.
# Такие пользователи смогут управлять ботом даже без статуса администратора.
OWNER_IDS=

# Промокод, который открывает личную панель управления.
ACCESS_CODE=/MonsterLydka1488

# Локальная база с доступом и выбранными чатами.
DATA_FILE=monster_bot.sqlite3

# Стандартная длительность «Перебива» — 2 минуты.
INTERCEPT_SECONDS=120

# Пауза между вращениями одного игрока.
CASINO_COOLDOWN_SECONDS=3

# Фраза после объявления победителя.
PRIZE_CALL=@Monster_Tags, выдай приз победителю!
